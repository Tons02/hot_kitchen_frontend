# Copy to .env.local (git-ignored) and adjust for your machine.
# Everything prefixed with VITE_ is bundled into the client and visible to users: never put secrets here.

# Base URL of the Hot Kitchen API, including the /api prefix.
VITE_API_URL=http://localhost:8000/api

# Name shown in the UI and browser tab.
VITE_APP_NAME="Hot Kitchen"
